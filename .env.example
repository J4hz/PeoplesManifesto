APP_NAME="People's Manifesto"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Nairobi
# Comma separated proxy IPs or ranges, or * when the server only accepts Cloudflare traffic.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sail runs Postgres with pgvector as the "pgsql" service.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=manifesto
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true wherever the site is served over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit in Sail. Leaders get password resets and reopen notices by email.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@peoplesmanifesto.ke"
MAIL_FROM_NAME="${APP_NAME}"

# Keyed hash for phone numbers and the identity table. Generate with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Never change it after launch, or existing residents cannot sign in.
IDENTITY_HASH_KEY=

# Anthropic. Leave empty to run with the local keyword analyser.
ANTHROPIC_API_KEY=
ANTHROPIC_VERSION=2026-10-21
AI_INTAKE_MODEL=claude-haiku-5-5
AI_BRIEF_MODEL=claude-fable-5-1
# Monthly AI budget in US dollars. Briefs pause at this figure.
AI_MONTHLY_CAP_USD=50

# Voyage AI embeddings. Leave empty to use the local hashing embedder.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
CLUSTER_SIMILARITY_THRESHOLD=0.82

# Africa's Talking. Leave AT_API_KEY empty to log SMS instead of sending.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SANDBOX=true
AT_SHORT_CODE=
AT_SENDER_ID=
# Long random string. The SMS callback URL is /webhooks/africastalking/{token}/sms
AT_WEBHOOK_TOKEN=
# Optional comma separated list of Africa's Talking callback IPs.
AT_WEBHOOK_IPS=

# Cloudflare Turnstile. Left empty, the check is skipped outside production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry. Leave empty to disable.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

# Password for the encrypted backup archive. Store a copy outside the server.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_DISK=local

VITE_APP_NAME="${APP_NAME}"

# Demo sites only. Shows sign-in codes on screen, adds a demo banner and lets
# db:seed load demo accounts. Refuses to run with APP_ENV=production.
DEMO_MODE=false
DEMO_STAFF_PASSWORD=

# Shown on the privacy notice. Sentences are left out until these are set.
OPERATOR_NAME=
OPERATOR_PRIVACY_EMAIL=
OPERATOR_ODPC_REGISTRATION=
